# =============================================================================
# Kids Deals Platform — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env com segredos reais.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=kidsdeals
POSTGRES_PASSWORD=altere-esta-senha
POSTGRES_DB=kids_deals
POSTGRES_PORT=5432

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Sao_Paulo
N8N_ENCRYPTION_KEY=gere-uma-chave-longa-e-aleatoria
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=altere-esta-senha

# --- Opportunity Engine ---
OPPORTUNITY_SCORE_THRESHOLD=70

# --- Shopee Afiliados (Sprint 1) ---
SHOPEE_AFFILIATE_ID=
SHOPEE_APP_ID=
SHOPEE_SECRET=

# --- Mercado Livre Afiliados (posterior) ---
ML_AFFILIATE_TOKEN=

# --- IA / LLM ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Meta / Instagram / WhatsApp Cloud ---
META_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BROADCAST_RECIPIENT=

# --- Telegram (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

